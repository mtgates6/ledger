# Supabase project (Settings -> API). Use the service_role key, NOT the
# anon/publishable key -- this app talks to Postgres only from the server,
# so the service_role key must never be exposed to the browser (no
# NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The passcode you'll type to unlock the app. Pick anything memorable.
APP_PASSCODE=change-me

# Random secret used to sign the unlock session cookie. Generate one with:
#   openssl rand -hex 32
APP_SESSION_SECRET=change-me-too
